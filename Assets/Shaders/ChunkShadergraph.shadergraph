{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a58ba288b7fb4f4489fd9c9ba065dc6a",
    "m_Title": "Why not HLSL?",
    "m_Content": "The shader is just a standard URP lit shader but doesn't use texture and the colour is just the vertex colour. A shader graph handles all the standard URP lit boilerplate and so it's simpler to use this",
